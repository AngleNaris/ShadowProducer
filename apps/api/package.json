{
  "name": "@shadowproducer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "analysis:worker": "tsx src/analysis-worker.ts",
    "media:worker": "tsx src/media-worker.ts",
    "start": "tsx src/server.ts",
    "lint": "biome check src",
    "test": "vitest run --exclude=src/**/*.postgres.test.ts",
    "test:postgres": "vitest run src/postgres-script-repository.postgres.test.ts src/postgres-contact-repository.postgres.test.ts src/postgres-workspace-repository.postgres.test.ts src/postgres-workspace-onboarding.postgres.test.ts src/postgres-analysis-job-repository.postgres.test.ts src/postgres-review-link-repository.postgres.test.ts src/postgres-data-export-repository.postgres.test.ts src/postgres-asset-repository.postgres.test.ts src/postgres-portfolio-repository.postgres.test.ts src/postgres-agent-command-repository.postgres.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@fastify/cors": "11.3.0",
    "@shadowproducer/application": "workspace:*",
    "@shadowproducer/contracts": "workspace:*",
    "better-auth": "1.7.2",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@shadowproducer/test-fixtures": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
