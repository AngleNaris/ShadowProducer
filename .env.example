NEXT_PUBLIC_ENABLE_REGISTRATION=true
AUTH_SEED_PASSWORD=replace-local-seed-password
ASSET_MAX_UPLOAD_BYTES=2147483648
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=shadowproducer
S3_SECRET_ACCESS_KEY=shadowproducer-dev-secret
