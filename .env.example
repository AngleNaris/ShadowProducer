S3_BROWSER_ORIGINS=http://127.0.0.1:3211,http://localhost:3211
MINIO_ROOT_USER=shadowproducer
MINIO_ROOT_PASSWORD=shadowproducer-dev-secret
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Remote OpenAI-compatible APIs only. Required endpoints:
# /audio/transcriptions, /chat/completions, and /embeddings.
# Missing or unavailable providers fail explicitly; there is no local-model or keyword fallback.
TRANSCRIPTION_API_BASE_URL=https://api.example.com/v1
